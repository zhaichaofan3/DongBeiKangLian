    {
      "start": 0.4,
      "end": 5.74,
      "text": "作为中国共产党创建最早"
    },
    {
      "start": 5.74,
      "end": 7.74,
      "text": "坚持抗日时间最长"
    },
    {
      "start": 7.74,
      "end": 11.74,
      "text": "条件最为坚苦的抗日无装力表"
    },
    {
      "start": 11.74,
      "end": 15.74,
      "text": "东北抗日连军在民族未忘之间"
    },
    {
      "start": 15.74,
      "end": 18.74,
      "text": "高庆抗日救活大情"
    },
    {
      "start": 18.74,
      "end": 23.74,
      "text": "在白山黑水坚在冰天雪地里"
    },
    {
      "start": 23.74,
      "end": 27.74,
      "text": "在忙忙宁海中不选之后"
    },
    {
      "start": 27.74,
      "end": 30.74,
      "text": "进行了坚苦主角的动政"
    },
    {
      "start": 30.74,
      "end": 34.74,
      "text": "终成于党的堅定性面"
    },
    {
      "start": 34.74,
      "end": 37.74,
      "text": "拥负国难的民族大利"
    },
    {
      "start": 37.74,
      "end": 41.74,
      "text": "学战到底的英雄气感"
    },
    {
      "start": 41.74,
      "end": 46.74,
      "text": "这是战火摩脸住城的东北抗联金山"
    },
    {
      "start": 46.74,
      "end": 50.74,
      "text": "也是中华民族再为自威难之敬"
    },
    {
      "start": 50.74,
      "end": 53.74,
      "text": "奉发的父亲强因"
    },
    {
      "start": 53.74,
      "end": 58.74,
      "text": "这一刻歷史越现实交响不如"
    },
    {
      "start": 58.74,
      "end": 61.74,
      "text": "把时光瞬间落回到"
    },
    {
      "start": 61.74,
      "end": 65.74,
      "text": "那个继续交职的神道"
    }
