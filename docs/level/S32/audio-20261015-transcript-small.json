  "segments": [
    {
      "start": 0.4,
      "end": 5.74,
      "text": "作為中國共產黨創建最早"
    },
    {
      "start": 5.74,
      "end": 7.74,
      "text": "堅持抗日時間最長"
    },
    {
      "start": 7.74,
      "end": 11.74,
      "text": "條件最為艱苦的抗日武裝力量"
    },
    {
      "start": 11.74,
      "end": 15.74,
      "text": "東北抗日聯軍在民族威望之際"
    },
    {
      "start": 15.74,
      "end": 18.74,
      "text": "高情抗日舊國大旗"
    },
    {
      "start": 18.74,
      "end": 21.74,
      "text": "在白山黑水間"
    },
    {
      "start": 21.74,
      "end": 23.74,
      "text": "在冰天雪地裡"
    },
    {
      "start": 23.74,
      "end": 27.74,
      "text": "在茫茫陵海中孤懸敵後"
    },
    {
      "start": 27.74,
      "end": 31.74,
      "text": "進行了艱苦卓絕的鬥爭"
    },
    {
      "start": 32.74,
      "end": 35.74,
      "text": "忠誠與黨的堅定信念"
    },
    {
      "start": 35.74,
      "end": 38.74,
      "text": "擁付國難的民族大義"
    },
    {
      "start": 38.74,
      "end": 41.74,
      "text": "血戰到底的英雄氣幹"
    },
    {
      "start": 41.74,
      "end": 46.74,
      "text": "這是戰火磨練鑄成的東北抗聯精神"
    },
    {
      "start": 46.74,
      "end": 50.74,
      "text": "也是中華民族在每次危難之際"
    },
    {
      "start": 50.74,
      "end": 53.74,
      "text": "奉發的復興強音"
    },
    {
      "start": 53.74,
      "end": 55.74,
      "text": "這一刻"
    },
    {
      "start": 55.74,
      "end": 58.74,
      "text": "歷史與現實交響共同"
    },
    {
      "start": 58.74,
      "end": 61.74,
      "text": "把時光瞬間拉回到"
    },
    {
      "start": 61.74,
      "end": 65.74,
      "text": "那個鐵血交織的時代"
    }
  ]
